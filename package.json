{
	"name": "amend-any-commit",
	"displayName": "Amend Any Commit",
	"description": "%description%",
	"version": "0.4.1",
	"publisher": "corentin-gautier",
	"license": "MIT",
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"SCM Providers"
	],
	"keywords": [
		"amend",
		"reword",
		"commit message",
		"edit commit",
		"rebase",
		"git graph"
	],
	"main": "./extension.js",
	"l10n": "./l10n",
	"enabledApiProposals": [
		"contribSourceControlHistoryItemMenu"
	],
	"activationEvents": [],
	"contributes": {
		"commands": [
			{
				"command": "amendAnyCommit.amend",
				"title": "%command.reword%",
				"category": "Git"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "amendAnyCommit.amend",
					"when": "false"
				}
			],
			"scm/historyItem/context": [
				{
					"command": "amendAnyCommit.amend",
					"when": "scmProvider == git && !listMultiSelection",
					"group": "4_modify@2"
				}
			]
		}
	}
}
